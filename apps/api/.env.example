# Copy to apps/api/.env for local development.

# Railway gives you this when you add a PostgreSQL database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movers

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Production: ".moverstech.xyz" so one login works on learn., space. and admin.
# Leave empty for local development.
COOKIE_DOMAIN=

# The websites allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Money Moves Business: online payments (bank transfer, Money Moves app, stablecoin).
# Secret key from https://business.usemoneymoves.xyz/settings/api-keys (sk_test_... or sk_live_...).
MONEYMOVES_SECRET_KEY=
# Webhook signing secret (whsec_...) from Developers → Webhooks. Point the webhook at
# https://api.moverstech.xyz/payments/moneymoves/webhook and send the payment.successful event.
MONEYMOVES_WEBHOOK_SECRET=

# Send it the payment.successful, refund.created and refund.completed events.

# Only for trying the sites with no Money Moves key at all: "true" makes "Pay online" succeed
# without paying. Ignored once MONEYMOVES_SECRET_KEY is set. Never set this in production.
DEV_FAKE_PAYMENTS=false

# WhatsApp number for payments, in international format without +.
WHATSAPP_NUMBER=2348165468975

# Where each part lives. Used in emails and for Google sign-in.
PUBLIC_API_URL=http://localhost:4000
LEARN_URL=http://localhost:5173
SPACE_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# Email through Resend (https://resend.com). moverstech.xyz is verified in Resend for sending.
# Locally, with no key, emails are printed in the API console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Movers <no-reply@moverstech.xyz>

# "Continue with Google" (Google Cloud console → APIs & Services → Credentials → OAuth client, Web).
# Authorised redirect URIs: https://api.moverstech.xyz/auth/google/callback and http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin, created when the API starts. Leave ADMIN_PASSWORD empty and they get an email saying
# their account is ready; they choose a password with "Forgot your password?" on the admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Movers Admin

# Automatic email reminders (payments due, quizzes closing, bookings tomorrow...). "off" stops them.
REMINDERS=on

TZ=Africa/Lagos
