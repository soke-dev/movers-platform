{
  "name": "@movers/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "build": "prisma generate",
    "start": "prisma migrate deploy && (node prisma/seed.js || true) && node src/index.js",
    "migrate": "prisma migrate deploy",
    "seed": "node --env-file-if-exists=.env prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  }
}
